+    def _shape_draft_logits(
+        self,
+        logits: torch.Tensor,
+        idx_mapping: torch.Tensor,
+        temperature: torch.Tensor,
+        cache_dtype: torch.dtype,
+    ) -> torch.Tensor:
+        """Graph-safe draft shaping: request top-k/top-p mask (on logits / T),
+        then 1/tau scaling. Returned in the draft-logits cache dtype so the
+        cached q is bitwise the distribution that is sampled from."""
+        out = logits.float()
+        if _DRAFT_TOPKP:
+            temp = temperature[idx_mapping].float()
+            temp = torch.where(temp > 0, temp, torch.ones_like(temp))
+            kmax = min(_DRAFT_TOPKP_KMAX, out.shape[-1])
+            vals, idx = torch.topk(out, kmax, dim=-1)  # sorted, descending
+            k = self.top_k[idx_mapping].clamp(min=1, max=kmax)
+            p = self.top_p[idx_mapping]
+            ar = torch.arange(kmax, device=out.device)
+            keep = ar[None, :] < k[:, None]
+            probs = torch.softmax(
+                torch.where(keep, vals / temp[:, None], float("-inf")), dim=-1
+            )
+            before = torch.cumsum(probs, dim=-1) - probs
+            keep = keep & (before < p[:, None])
+            keep[:, 0] = True
+            masked = torch.full_like(out, float("-inf"))
+            masked.scatter_(1, idx, torch.where(keep, vals, float("-inf")))
+            out = masked
+        if _DRAFT_TAU != 1.0:
+            out = out / _DRAFT_TAU
+        return out.to(cache_dtype)
+
