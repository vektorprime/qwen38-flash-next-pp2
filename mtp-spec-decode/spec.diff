+# Local spec-decode switches (all default off = stock behaviour).
+#   VLLM_SPEC_DRAFT_INDEP_NOISE=1  probabilistic drafting draws its Gumbel noise from a key independent of
+#                                  the target's (seed ^ const). Stock keys the draft with the same
+#                                  (seed, position) as the target's residual resample, which biases the
+#                                  output distribution after a rejection.
+#   VLLM_SPEC_DRAFT_TOPKP=1        mask draft logits with the request's top-k / top-p (computed at the
+#                                  request temperature) before sampling and caching them.
+#   VLLM_SPEC_DRAFT_TAU=<t>        draft temperature scale: q = softmax(logits / (t * T)). t < 1 sharpens.
+#   VLLM_SPEC_DRAFT_TOPKP_KMAX=<k> static candidate count for the mask (default 64).
+# All three only change the draft distribution q; the cached logits are exactly the ones sampled from, so
+# rejection sampling stays lossless.
+_DRAFT_INDEP_NOISE = os.environ.get("VLLM_SPEC_DRAFT_INDEP_NOISE", "0") == "1"
+_DRAFT_TOPKP = os.environ.get("VLLM_SPEC_DRAFT_TOPKP", "0") == "1"
+_DRAFT_TAU = float(os.environ.get("VLLM_SPEC_DRAFT_TAU", "1.0"))
+_DRAFT_TOPKP_KMAX = int(os.environ.get("VLLM_SPEC_DRAFT_TOPKP_KMAX", "64"))
+_DRAFT_SEED_XOR = 0x2545F4914F6CDD1D
+#   VLLM_SPEC_STEP_UNIQUE_RNG=1    (for block verification) draft Gumbel noise keyed by (first draft position * 8
+#                                  + draft index) so a step never reuses noise of drafts that the previous block
+#                                  decision examined. Must be paired with the same flag in rejection_sampler_utils.
+_STEP_UNIQUE_RNG = os.environ.get("VLLM_SPEC_STEP_UNIQUE_RNG", "0") == "1"
+
+
+def draft_noise_positions(sample_positions: torch.Tensor, draft_step: torch.Tensor) -> torch.Tensor:
+    """Gumbel key positions for draft sampling. Stock: the target row position that verifies the draft
+    (positions + 1). Step-unique: first_draft_pos * 8 + draft index (k <= 7)."""
+    if not _STEP_UNIQUE_RNG:
+        return sample_positions
+    first = sample_positions - draft_step
+    return first * 8 + draft_step
