+@triton.jit
+def _ring_zero_kernel(
+    # [max_num_reqs]
+    ring_ptr,
+    max_num_reqs,
+    BLOCK_SIZE: tl.constexpr,
+):
+    """FIX (0012): zero a parity-ring slot at the start of each real engine
+    step, so a step in which a request was NOT scheduled contributes 0 to the
+    deferred align correction (cadence/defer/async-safe)."""
+    offsets = tl.program_id(0) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    mask = offsets < max_num_reqs
+    tl.store(ring_ptr + offsets, 0, mask=mask)
+
+
+def ring_zero_(ring: torch.Tensor) -> None:
+    max_num_reqs = ring.numel()
+    _ring_zero_kernel[(triton.cdiv(max_num_reqs, 1024),)](
+        ring, max_num_reqs, BLOCK_SIZE=1024
+    )
+
+
+@triton.jit
+def _pp_peek_rej_correction_kernel(
+    # [num_reqs] batch_idx -> req_state_idx; negative means skip.
+    idx_mapping_ptr,
+    # [num_reqs] rejections for the peeked step (last-rank broadcast).
+    num_rejected_ptr,
+    # [max_num_reqs] parity-ring slot for the peeked step.
+    ring_ptr,
+    # [max_num_reqs] num_computed GPU mirror.
+    num_computed_ptr,
+    num_reqs,
+):
+    """FIX (0012, exact-mirror mode): at the start of step S, the previous
+    step's (S-1) sampled results are already received (peeked, not consumed).
+    Fold rejection(S-1) into the GPU mirror and the ring NOW, so the mirror is
+    exact (== last rank) for preprocess/positions/forward, and the ring entry
+    becomes the net advance q(S-1)-rej(S-1) that the deferred align decision
+    subtracts for the step it serves."""
+    batch_idx = tl.program_id(0)
+    if batch_idx >= num_reqs:
+        return
+    req_idx = tl.load(idx_mapping_ptr + batch_idx)
+    if req_idx < 0:
+        return
+    rej = tl.load(num_rejected_ptr + batch_idx)
+    if rej == 0:
+        return
+    ring = tl.load(ring_ptr + req_idx)
+    tl.store(ring_ptr + req_idx, ring - rej)
+    num_computed = tl.load(num_computed_ptr + req_idx)
+    tl.store(num_computed_ptr + req_idx, num_computed - rej)
+
+
+def pp_peek_rej_correction(
+    idx_mapping: torch.Tensor,
+    num_rejected: torch.Tensor,
+    ring: torch.Tensor,
+    num_computed_tokens: torch.Tensor,
+) -> None:
+    num_reqs = idx_mapping.shape[0]
+    _pp_peek_rej_correction_kernel[(num_reqs,)](
+        idx_mapping, num_rejected, ring, num_computed_tokens, num_reqs
     )
 
 
