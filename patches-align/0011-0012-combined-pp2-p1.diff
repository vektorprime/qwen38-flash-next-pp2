+    def peek_pending_correction(
+        self,
+    ) -> tuple[np.ndarray, torch.Tensor, torch.cuda.Event] | None:
+        """FIX (0012): data for the exact-mirror peek correction at the start
+        of the current step S: the PREVIOUS step's PendingRecv (queue[-1],
+        written by st(S-1); the current pop of P(S-2) at queue[0] happens
+        later in the same engine step, in get_prev_sampled_outputs).
+        Returns (filtered idx_mapping_np with -1
+        for freed/unneeded rows, num_rejected GPU tensor, recv event), or None
+        when the previous step skipped the broadcast. Read-only: does NOT
+        consume the slot."""
+        if not self.queue:
+            return None
+        # queue[-1] holds the entry written by st(S-1) (`receive` writes
+        # queue[-1]); queue[0] is the entry the pop later in THIS engine step
+        # will consume. Peek target is the newest, i.e. queue[-1].
+        slot = self.queue[-1]
+        if slot is None:
+            return None
+        freed = self.req_idx_gen_np[slot.idx_mapping_np] != slot.gen_at_receive_np
+        exclude_mask = freed | ~slot.need_sampled_mask
+        idx_mapping_np = np.where(exclude_mask, -1, slot.idx_mapping_np)
+        return idx_mapping_np, slot.num_rejected, slot.event
+
